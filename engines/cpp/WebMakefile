# Compiler and flags
CXX = em++
PYTHON ?= python3

ifeq ($(OS),Windows_NT)
    PYTHON = python
    RM = del /F /Q
else
    RM = rm -f
endif

CXXFLAGS = -Wall -std=c++17
RELEASEFLAGS ?= -O2
BUILDFLAGS = $(CXXFLAGS) $(RELEASEFLAGS)

# Source and include directories
SRCDIR = src
WEBDIR = web

# Find all C++ source and header files recursively
ifeq ($(OS),Windows_NT)
    SRC = $(shell dir /B /S $(SRCDIR)\*.cpp)
    HDR = $(shell dir /B /S $(SRCDIR)\*.hpp)
else
    SRC = $(shell find $(SRCDIR) -type f -name '*.cpp')
    HDR = $(shell find $(SRCDIR) -type f -name '*.hpp')
endif

# Exclude the native entry point
SRC := $(filter-out $(SRCDIR)/main.cpp, $(SRC))

# Include directories
INCFLAGS = -I$(SRCDIR)

# WebAssembly target
WEBAPI = $(WEBDIR)/web_api.cpp
TARGET = $(WEBDIR)/brainfuck.js
WASM = $(WEBDIR)/brainfuck.wasm

# Emscripten flags
EMFLAGS = $(BUILDFLAGS) $(INCFLAGS) \
    --no-entry \
    -sMODULARIZE=1 \
    -sEXPORT_ES6=1 \
    -sEXPORTED_FUNCTIONS='["_run_brainfuck"]' \
    -sEXPORTED_RUNTIME_METHODS='["ccall"]' \
    -sALLOW_MEMORY_GROWTH=1 \
    -sSTACK_SIZE=1048576 \
    -sINITIAL_MEMORY=67108864 \
    -sASSERTIONS=2 \
    -sSTACK_OVERFLOW_CHECK=2

.PHONY: all web serve clean-web

all: web

web: $(TARGET)

# Build the WebAssembly JavaScript module
$(TARGET): $(WEBAPI) $(SRC) $(HDR)
	$(CXX) $(EMFLAGS) $(WEBAPI) $(SRC) -o $(TARGET)

serve:
	$(PYTHON) -m http.server 8000 -d $(WEBDIR)

clean-web:
ifeq ($(OS),Windows_NT)
	-if exist "$(TARGET)" del /F /Q "$(subst /,\,$(TARGET))"
	-if exist "$(WASM)" del /F /Q "$(subst /,\,$(WASM))"
else
	$(RM) "$(TARGET)" "$(WASM)"
endif
